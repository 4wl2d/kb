{
  "$comment": "Generated by `kb schema --write` from the Rust model in core/cli/src; do not edit.",
  "$defs": {
    "BudgetUnit": {
      "enum": [
        "tokens-est",
        "bytes"
      ],
      "type": "string"
    },
    "Intent": {
      "enum": [
        "implement",
        "refactor",
        "debug",
        "review",
        "explain",
        "diagnose"
      ],
      "type": "string"
    },
    "RoutingCase": {
      "additionalProperties": false,
      "properties": {
        "applicability_reviewed": {
          "default": false,
          "description": "All delivered mandatory records were adjudicated for applicability.",
          "type": "boolean"
        },
        "budget": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "budget_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetUnit"
            },
            {
              "type": "null"
            }
          ]
        },
        "change_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "concepts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expect_ambiguous": {
          "default": [],
          "description": "Normalized phrases expected to be reported as ambiguous.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expect_budget_exceeded": {
          "default": false,
          "description": "Expect CONTEXT_BUDGET_EXCEEDED.",
          "type": "boolean"
        },
        "expect_included": {
          "default": [],
          "description": "Ids that must be included in any tier.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expect_mandatory": {
          "default": [],
          "description": "Ids that must be in the mandatory tier.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expect_order": {
          "default": [],
          "description": "Expected relative order of distinct record ids in the delivered context.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expect_status": {
          "description": "Expected completeness status (`complete`, `partial`, `conflict`, `incomplete`).",
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "forbid": {
          "default": [],
          "description": "Ids that must not appear at all.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "host_versions": {
          "default": [],
          "description": "`repo=version` host versions.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "max_tokens": {
          "description": "Ceiling for the complete compact response, using the engine's token estimator.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "min_recall_percent": {
          "description": "Minimum recall@k, as an integer percentage. Requires `relevant` labels.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "modules": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "not_applicable": {
          "default": [],
          "description": "Human-labeled mandatory false positives. This is not inferred from missing labels.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "recall_k": {
          "description": "Top-k cutoff over distinct record ids, in delivery order (default 10).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "relevant": {
          "default": [],
          "description": "Human-labeled relevant records; unlabeled cases have no recall estimate.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repos": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "task": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "intent"
      ],
      "type": "object"
    }
  },
  "$id": "kb:schema/routing-test/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Golden context requests with expected mandatory and forbidden ids.",
  "properties": {
    "case": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RoutingCase"
      },
      "type": "array"
    },
    "schema": {
      "const": 1,
      "description": "Document schema version (must be 1).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema"
  ],
  "title": "Routing fixtures (routing-tests/*.toml)",
  "type": "object"
}

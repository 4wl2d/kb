{
  "$comment": "Generated by `kb schema --write` from the Rust model in core/cli/src; do not edit.",
  "$defs": {
    "Feature": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Registry id, unique within its registry file.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
          "type": "string"
        },
        "paths": {
          "default": [],
          "description": "Globs (optionally `repo:`-qualified) of files implementing the feature.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repos": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    }
  },
  "$id": "kb:schema/registry-features/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Product features, their repos and path globs.",
  "properties": {
    "feature": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Feature"
      },
      "type": "array"
    },
    "schema": {
      "const": 1,
      "description": "Document schema version (1 or 2).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema"
  ],
  "title": "Feature registry (registry/features.toml)",
  "type": "object"
}

{
  "$comment": "Generated by `kb schema --write` from the Rust model in core/cli/src; do not edit.",
  "$defs": {
    "Harness": {
      "enum": [
        "claude",
        "codex",
        "cursor"
      ],
      "type": "string"
    },
    "Intent": {
      "enum": [
        "implement",
        "refactor",
        "debug",
        "review",
        "explain"
      ],
      "type": "string"
    },
    "SkillSnapshot": {
      "enum": [
        "auto",
        "latest",
        "pinned"
      ],
      "type": "string"
    }
  },
  "$id": "kb:schema/skill-config/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed project settings for generated harness integrations.",
  "properties": {
    "default_intent": {
      "$ref": "#/$defs/Intent",
      "default": "implement",
      "description": "Default intent suggested in examples."
    },
    "harnesses": {
      "description": "Harnesses to integrate: `claude`, `codex`, `cursor`.",
      "items": {
        "$ref": "#/$defs/Harness"
      },
      "type": "array"
    },
    "kb_path": {
      "description": "Host-relative path of the KB checkout (submodule path), e.g. `.kb`.",
      "type": "string"
    },
    "notes": {
      "description": "Extra project notes appended to the skill (plain Markdown, non-normative).",
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "const": 1,
      "description": "Document schema version (must be 1).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "snapshot": {
      "$ref": "#/$defs/SkillSnapshot",
      "default": "auto",
      "description": "Snapshot selection written as `--snapshot` into every generated kbw command; `latest`\nand `pinned` override a host `.kbw.toml` `selection`, `auto` defers to it."
    }
  },
  "required": [
    "schema",
    "harnesses",
    "kb_path"
  ],
  "title": "Skill settings (skill-config/skill.toml)",
  "type": "object"
}

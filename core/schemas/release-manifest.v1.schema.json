{
  "$comment": "Generated by `kb schema --write` from the Rust model in core/cli/src; do not edit.",
  "$id": "kb:schema/release-manifest/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Engine and contract versions, toolchain pin and path ownership.",
  "properties": {
    "document_schema": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "engine_paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "engine_version": {
      "type": "string"
    },
    "index_schema": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "manifest": {
      "const": 1,
      "description": "Bootstrap manifest version (must be 1).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "migrates_from": {
      "default": [],
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "min_git": {
      "type": "string"
    },
    "project_paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "protocol": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "rust_toolchain": {
      "type": "string"
    },
    "skill_protocol": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "manifest",
    "engine_version",
    "document_schema",
    "protocol",
    "index_schema",
    "skill_protocol",
    "rust_toolchain",
    "min_git",
    "engine_paths",
    "project_paths"
  ],
  "title": "Bootstrap and compatibility manifest (core/release.toml)",
  "type": "object"
}

{
  "$comment": "Generated by `kb schema --write` from the Rust model in core/cli/src; do not edit.",
  "$defs": {
    "BudgetUnit": {
      "enum": [
        "tokens-est",
        "bytes"
      ],
      "type": "string"
    },
    "ContextSection": {
      "additionalProperties": false,
      "properties": {
        "default_budget": {
          "default": 8000,
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "default_budget_unit": {
          "$ref": "#/$defs/BudgetUnit",
          "default": "tokens-est"
        },
        "max_supplementary": {
          "default": 12,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "KnowledgeSection": {
      "additionalProperties": false,
      "properties": {
        "roots": {
          "default": [
            "knowledge"
          ],
          "description": "Knowledge roots relative to the profile directory.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "type": "object"
    },
    "ProjectSection": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "description": "First segment of every record id.",
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "namespace"
      ],
      "type": "object"
    },
    "SourceSection": {
      "additionalProperties": false,
      "properties": {
        "allowed_protocols": {
          "default": [
            "https",
            "ssh"
          ],
          "description": "Explicit transport policy for fetches (`https`, `ssh`, `git`, `file`, `http`).",
          "items": {
            "pattern": "^(https|ssh|git|file|http)$",
            "type": "string"
          },
          "type": "array"
        },
        "approved_ref": {
          "description": "Fully qualified approved ref, e.g. `refs/heads/main`.",
          "not": {
            "pattern": "\\.\\."
          },
          "pattern": "^refs/",
          "type": "string"
        },
        "remote": {
          "default": "origin",
          "description": "Git remote name in the KB checkout whose `approved_ref` is the trust boundary.",
          "pattern": "^[^-\\s]\\S*$",
          "type": "string"
        }
      },
      "required": [
        "approved_ref"
      ],
      "type": "object"
    }
  },
  "$id": "kb:schema/project/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Trusted profile configuration: namespace, approved source, knowledge roots.",
  "properties": {
    "context": {
      "$ref": "#/$defs/ContextSection",
      "default": {
        "default_budget": 8000,
        "default_budget_unit": "tokens-est",
        "max_supplementary": 12
      }
    },
    "knowledge": {
      "$ref": "#/$defs/KnowledgeSection",
      "default": {
        "roots": [
          "knowledge"
        ]
      }
    },
    "project": {
      "$ref": "#/$defs/ProjectSection"
    },
    "schema": {
      "const": 1,
      "description": "Document schema version (1 or 2).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/SourceSection"
    }
  },
  "required": [
    "schema",
    "project",
    "source"
  ],
  "title": "Profile config (project/project.toml)",
  "type": "object"
}

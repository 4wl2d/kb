#!/bin/sh
# kbw: deprecated forwarder to the `kb` command (docs/architecture.md, section 9; ADR 0017).
#
# The kb engine is run by the installed `kb` command, which selects the engine of each KB
# checkout by its fingerprint. This file only keeps scripts, CI jobs, generated skills and
# kbw-era engines that still call `<kb>/kbw` working: it runs `kb` for this checkout
# (KB_ROOT) and maps the old launcher flags to `kb engine ...`. It will be removed in a later
# release; call `kb` directly.
set -eu
unset CDPATH

kbw_die() { # <code> <status> <message...>
	kbw_code=$1
	kbw_status=$2
	shift 2
	printf 'kbw: error[%s]: %s\n' "$kbw_code" "$*" >&2
	exit "$kbw_status"
}

# Physical directory of this script, following symlinks to the script itself.
kbw_resolve_root() {
	kbw_self=$0
	case $kbw_self in */*) ;; *) kbw_self=./$kbw_self ;; esac
	while [ -L "$kbw_self" ]; do
		kbw_link=$(readlink -- "$kbw_self") || return 1
		case $kbw_link in
		/*) kbw_self=$kbw_link ;;
		*) kbw_self=${kbw_self%/*}/$kbw_link ;;
		esac
	done
	kbw_dir=${kbw_self%/*}
	cd -P -- "${kbw_dir:-/}" && pwd
}

if [ "${1-}" = --kbw-help ]; then
	cat <<'EOF'
kbw - deprecated forwarder to the kb command

Run `kb <command>` instead: kb finds the KB checkout from the current directory (or
--root/KB_ROOT) and runs the engine that checkout pins. Until removal, kbw runs
`kb <arguments>` for its own checkout and maps the old launcher flags:

  --kbw-fingerprint       kb engine fingerprint
  --kbw-bootstrap         kb engine bootstrap
  --kbw-runtime-info      kb engine info
  --kbw-install-artifact  kb engine install <archive> (--sha256 <hex> | --sha256-file <file>)
  --kbw-package <dir>     kb engine package <dir>

KBW_AUTO_BOOTSTRAP, KBW_CARGO_TARGET_DIR and KBW_ALLOW_TOOLCHAIN_MISMATCH are passed on as
their KB_* names. Install kb: see README.md, section "Install".
EOF
	exit 0
fi

KBW_ROOT=$(kbw_resolve_root) || kbw_die KBW_USAGE 2 "cannot resolve the directory of $0"

# A `kb` on PATH that runs this file again (in the same process, through exec) is a loop.
if [ "${KBW_FORWARDED:-}" = "$$" ]; then
	kbw_die KBW_LOOP 2 "the kb on PATH ($(command -v kb)) runs kbw again; install the kb command (README.md, section \"Install\") and put it first on PATH"
fi
command -v kb >/dev/null 2>&1 ||
	kbw_die KB_NOT_INSTALLED 50 "the kb command is not on PATH; install it (see $KBW_ROOT/README.md, section \"Install\"), then run kb instead of kbw"

for kbw_name in AUTO_BOOTSTRAP CARGO_TARGET_DIR ALLOW_TOOLCHAIN_MISMATCH; do
	eval "kbw_old=\${KBW_$kbw_name:-} kbw_new=\${KB_$kbw_name:-}"
	if [ -n "$kbw_old" ] && [ -z "$kbw_new" ]; then
		eval "KB_$kbw_name=\$kbw_old; export KB_$kbw_name"
	fi
done

if [ -t 2 ]; then
	# shellcheck disable=SC2016 # the backquotes are text
	printf 'kbw: deprecated: run `kb %s` instead (kb finds this checkout itself)\n' "${1-<command>}" >&2
fi

KB_ROOT=$KBW_ROOT
KBW_FORWARDED=$$
export KB_ROOT KBW_FORWARDED

case ${1-} in
--kbw-fingerprint | --kbw-bootstrap | --kbw-runtime-info)
	[ $# -eq 1 ] || kbw_die KBW_USAGE 2 "$1 takes no arguments"
	case $1 in
	--kbw-fingerprint) exec kb engine fingerprint ;;
	--kbw-bootstrap) exec kb engine bootstrap ;;
	*) exec kb engine info ;;
	esac
	;;
--kbw-install-artifact)
	shift
	exec kb engine install "$@"
	;;
--kbw-package)
	shift
	exec kb engine package "$@"
	;;
--kbw-*)
	kbw_die KBW_USAGE 2 "unknown launcher flag $1 (see $0 --kbw-help)"
	;;
*)
	exec kb "$@"
	;;
esac
